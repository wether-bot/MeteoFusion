# all | telegram | api
APP_MODE=all
# Required in all and telegram mode; API-only does not need a bot token.
BOT_TOKEN=
# Optional, but required to unlock admin API endpoints.
API_KEY=
API_HOST=0.0.0.0
API_PORT=8000

# SQLite is default. Optional PostgreSQL:
# postgresql+asyncpg://weather:password@postgres:5432/weather
DATABASE_URL=sqlite+aiosqlite:////data/weather.db

# Optional shared Redis cache; leave empty to use in-process memory.
REDIS_URL=
CACHE_TTL_SECONDS=900
REQUEST_TIMEOUT_SECONDS=12
FORECAST_DAYS=7
MET_USER_AGENT=WetherBot/0.1 (+https://github.com/wether-bot/wether-bot)
ENABLE_OPEN_METEO=true
ENABLE_GFS=true
ENABLE_ICON=true
ENABLE_ECMWF=true
ENABLE_MET_NO=true

# Optional paid/limited data vendors:
OPENWEATHER_API_KEY=
WEATHERAPI_KEY=
